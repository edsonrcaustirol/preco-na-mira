{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "preco-na-mira",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-16",
  "preview_urls": true,
  "build": {
    "command": "npm run build:site"
  },
  "vars": {
    "PNM_CF_ACCOUNT_ID": "84d8de00cbfabe263c406d9a9dfca92c"
  },
  "routes": [
    {
      "pattern": "preconamira.com.br",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PNM_ANALYTICS",
      "dataset": "pnm_commercial_m1"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/__pnm/analytics", "/__pnm/commercial"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
