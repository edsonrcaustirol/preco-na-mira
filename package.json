    "check": "npm run test:m3-2-related-scope && npm run audit:m3-2-related-scope && npm run build:site && npm run test:e2-catalog-operations && npm run validate:e2-catalog && npm run test:e1-1-mobile-listings && npm run test:m1 && npm run test:m2-1 && npm run test:m3-1 && npm run test:m2-2 && npm run audit:strict && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
