{
  "name": "preco-na-mira",
  "version": "18.4.0",
  "private": true,
  "scripts": {
    "prepare:platform": "node scripts/preparar-plataforma.mjs",
    "build:mobile-data": "node scripts/gerar-dados-mobile.mjs",
    "build:dewalt-queue": "node scripts/gerar-fila-dewalt.mjs",
    "build:seo": "node scripts/gerar-seo-estatico.mjs",
    "refine:offers": "node scripts/refinar-ofertas-curadas.mjs",
    "build:offers-data": "node scripts/gerar-payload-ofertas.mjs",
    "finalize:seo": "node scripts/finalizar-seo.mjs",
    "build:site": "npm run build:mobile-data && npm run build:dewalt-queue && npm run build:seo && npm run refine:offers && npm run build:offers-data && npm run prepare:platform && npm run finalize:seo",
    "sync:compatibility": "node scripts/sincronizar-compatibilidade.mjs",
    "audit": "node scripts/auditar-site.mjs",
    "audit:strict": "node scripts/auditar-site.mjs --strict",
    "preview": "node scripts/preview.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "check": "npm run build:site && npm run audit:strict && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
