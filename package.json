    "sync:compatibility": "node scripts/sincronizar-compatibilidade.mjs",
    "audit": "node scripts/auditar-site.mjs",
    "audit:strict": "node scripts/auditar-site.mjs --strict && node scripts/auditar-seo-p9.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "wrangler deploy",
