    "refine:offers": "node scripts/refinar-ofertas-curadas.mjs",
    "build:offers-data": "node scripts/gerar-payload-ofertas.mjs",
    "finalize:seo": "node scripts/finalizar-seo.mjs",
    "instrument:m1": "node scripts/injetar-analytics-m1.mjs",
    "test:m1": "node scripts/test-m1-analytics.mjs",
    "analytics:m2-1": "node scripts/m2-1-analytics.mjs",
    "test:m2-1": "node scripts/test-m2-1-analytics.mjs",
    "analytics:m3-1": "node scripts/m3-1-analytics.mjs",
    "test:m3-1": "node scripts/test-m3-1-analytics.mjs",
